# GhostOps environment. Copy to .env and fill in. Never commit .env.

# Ed25519 private key that signs Risk Certificates (base64 PKCS#8, or a base64 32-byte seed).
# Anyone can verify with the public key from GET /public-key; only this key can sign.
# Generate: .venv\Scripts\python.exe -m app.keys generate
# and paste the GHOSTOPS_SIGNING_KEY=... line it prints here yourself.
GHOSTOPS_SIGNING_KEY=

# Legacy HMAC-SHA256 secret (64 hex chars). Needed only to keep verifying certificates
# signed before Ed25519, or to sign with HMAC when GHOSTOPS_SIGNING_KEY is empty.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GHOSTOPS_HMAC_SECRET=

# Dummy credentials for MiniStack. NEVER put real AWS credentials here.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# MiniStack gateway (all services on one port; default 4566).
MINISTACK_ENDPOINT_URL=http://localhost:4566

# SQLite file for certificates and the audit log (blank = data/ghostops.db).
GHOSTOPS_DB_PATH=

# Postgres instead of SQLite, e.g. a free Neon database (README "Deploying"). Blank = SQLite.
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require  -- secret: never commit or share it.
GHOSTOPS_DATABASE_URL=

# Budget gate: a change whose monthly cost increase is above this (USD) is blocked for
# review (finding GO-BUDGET-001). Blank = 500. "off" disables the gate.
GHOSTOPS_MONTHLY_BUDGET_USD=500

# Groq API key for plain-English risk explanations. https://console.groq.com/keys
GROQ_API_KEY=
# Groq model used for explanations.
GROQ_MODEL=openai/gpt-oss-120b

# Infracost: no API key. The v2 CLI uses OAuth login stored on this machine.
# One-time setup: `infracost auth login`, then check with `infracost doctor`.
# Optional: org slug to scan against (blank = CLI default org).
INFRACOST_ORG=
